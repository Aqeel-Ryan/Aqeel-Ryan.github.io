---
import { formatDate, type Post } from '../lib/posts';
import { postPath, tagPath } from '../lib/urls';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? <p class="muted">No posts yet.</p> : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a class="post-title" href={postPath(p.slug)}>{p.data.title}</a>
        <p class="muted">
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          {p.data.tags.map((t) => <> · <a href={tagPath(t)}>#{t}</a></>)}
        </p>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
)}
